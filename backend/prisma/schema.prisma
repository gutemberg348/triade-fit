generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STUDENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonKind {
  CONTENT
  WORKOUT
  MEDITATION
}

enum ProgramType {
  CONTENT
  TRAINING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum AccessStatus {
  PENDING_PAYMENT
  ACTIVE
  OVERDUE
  BLOCKED
  CANCELLED
}

enum ReferralStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum PartnerLedgerType {
  CREDIT
  DEBIT
  ADJUSTMENT
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  CANCELLED
  REFUNDED
}

enum Audience {
  ALL
  ACTIVE_STUDENTS
  SPECIFIC_STUDENTS
}

enum PhotoPose {
  FRONT
  SIDE
  BACK
}

model User {
  id                    String               @id @default(uuid()) @db.Uuid
  email                 String               @unique
  passwordHash          String
  role                  Role                 @default(STUDENT)
  status                AccountStatus        @default(ACTIVE)
  name                  String
  phone                 String?
  birthDate             DateTime?            @db.Date
  avatarUrl             String?
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  studentProfile        StudentProfile?
  recordedMeasurements  BodyMeasurement[]    @relation("MeasurementAuthor")
  createdAnnouncements  Announcement[]       @relation("AnnouncementAuthor")
  createdCommunityPosts CommunityPost[]      @relation("CommunityPostAuthor")
  communityPostLikes    CommunityPostLike[]
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  notifications         Notification[]

  @@index([role, status])
  @@index([createdAt])
}

model StudentProfile {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @unique @db.Uuid
  objective              String?
  notes                  String?
  initialHeightCm        Decimal?                @db.Decimal(5, 2)
  accessStatus           AccessStatus            @default(PENDING_PAYMENT)
  accessExpiresAt        DateTime?
  gatewayCustomerId      String?                 @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments            StudentProgram[]
  lessonProgress         LessonProgress[]
  measurements           BodyMeasurement[]
  progressPhotos         ProgressPhoto[]
  announcementRecipients AnnouncementRecipient[]
  partnerProfile         PartnerProfile?
  receivedReferral       Referral?               @relation("ReferralStudent")
  paymentOrders          PaymentOrder[]

  @@index([createdAt])
}

model PaymentOrder {
  id                 String                @id @default(uuid()) @db.Uuid
  studentId          String                @db.Uuid
  provider           String                @default("ASAAS")
  planCode           String
  amountCents        Int
  paymentMethod      String?
  durationMonths     Int                   @default(12)
  status             PaymentStatus         @default(PENDING)
  externalReference  String                @unique
  providerCheckoutId String?               @unique
  providerPaymentId  String?               @unique
  checkoutUrl        String?
  expiresAt          DateTime?
  paidAt             DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  student            StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  webhookEvents      PaymentWebhookEvent[]

  @@index([studentId, status, createdAt(sort: Desc)])
}

model AppConfig {
  id                  String   @id @default("app")
  appName             String   @default("Triade FIT")
  loginImageUrl       String?
  loginEyebrow        String   @default("SUA JORNADA COMEÇA AQUI")
  loginHeadline       String   @default("Seu corpo pede equilíbrio.")
  loginSubtitle       String   @default("Treinos, cuidado e evolução lado a lado, no seu ritmo.")
  homeBannerUrl       String?
  homeBannerLabel     String   @default("CONTINUE SUA JORNADA")
  paymentBannerUrl    String?
  planTitle           String   @default("Plano Triade FIT — 12 meses")
  planDescription     String   @default("Acesso completo por 12 meses")
  planDurationMonths  Int      @default(12)
  pixPriceCents       Int      @default(1200)
  cardBasePriceCents  Int      @default(1200)
  cardInstallments    Int      @default(12)
  cardInterestPercent Decimal  @default(0) @db.Decimal(6, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaymentWebhookEvent {
  id              String        @id @default(uuid()) @db.Uuid
  providerEventId String        @unique
  event           String
  paymentOrderId  String?       @db.Uuid
  receivedAt      DateTime      @default(now())
  paymentOrder    PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([paymentOrderId, receivedAt(sort: Desc)])
}

model PartnerProfile {
  id                 String               @id @default(uuid()) @db.Uuid
  studentId          String               @unique @db.Uuid
  referralCode       String               @unique
  active             Boolean              @default(true)
  defaultCreditCents Int                  @default(0)
  balanceCents       Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  student            StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  referrals          Referral[]           @relation("ReferralPartner")
  ledgerEntries      PartnerLedgerEntry[]

  @@index([active])
}

model Referral {
  id               String              @id @default(uuid()) @db.Uuid
  partnerId        String              @db.Uuid
  studentId        String              @unique @db.Uuid
  status           ReferralStatus      @default(PENDING)
  creditCents      Int                 @default(0)
  paymentReference String?             @unique
  approvedAt       DateTime?
  createdAt        DateTime            @default(now())
  partner          PartnerProfile      @relation("ReferralPartner", fields: [partnerId], references: [id], onDelete: Restrict)
  student          StudentProfile      @relation("ReferralStudent", fields: [studentId], references: [id], onDelete: Cascade)
  ledgerEntry      PartnerLedgerEntry?

  @@index([partnerId, status])
}

model PartnerLedgerEntry {
  id          String            @id @default(uuid()) @db.Uuid
  partnerId   String            @db.Uuid
  referralId  String?           @unique @db.Uuid
  type        PartnerLedgerType
  amountCents Int
  description String
  createdAt   DateTime          @default(now())
  partner     PartnerProfile    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referral    Referral?         @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([partnerId, createdAt(sort: Desc)])
}

model Program {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  description String
  coverUrl    String?
  type        ProgramType      @default(CONTENT)
  sortOrder   Int              @default(0)
  status      PublishStatus    @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  modules     Module[]
  enrollments StudentProgram[]

  @@index([status, sortOrder])
  @@index([type, status, sortOrder])
}

model Module {
  id              String        @id @default(uuid()) @db.Uuid
  programId       String        @db.Uuid
  title           String
  description     String?
  coverUrl        String?
  unlockDelayDays Int           @default(0)
  sortOrder       Int           @default(0)
  status          PublishStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  program         Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons         Lesson[]

  @@unique([programId, sortOrder])
  @@index([programId, status])
}

model Lesson {
  id                   String           @id @default(uuid()) @db.Uuid
  moduleId             String           @db.Uuid
  title                String
  description          String?
  coverUrl             String?
  videoUrl             String?
  instructions         String?
  durationMinutes      Int?
  category             String?
  kind                 LessonKind       @default(WORKOUT)
  isIntroductory       Boolean          @default(false)
  showMeditationButton Boolean          @default(false)
  unlockDelayHours     Int              @default(0)
  difficulty           String?
  sortOrder            Int              @default(0)
  status               PublishStatus    @default(DRAFT)
  materials            Json?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  module               Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress             LessonProgress[]

  @@unique([moduleId, sortOrder])
  @@index([moduleId, status])
  @@index([isIntroductory, status, sortOrder])
}

model CommunityPost {
  id              String              @id @default(uuid()) @db.Uuid
  createdById     String              @db.Uuid
  authorName      String
  authorAvatarUrl String?
  message         String
  imageUrl        String?
  status          PublishStatus       @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation("CommunityPostAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  likes           CommunityPostLike[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([createdById])
}

model CommunityPostLike {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  userId    String        @db.Uuid
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

model StudentProgram {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @db.Uuid
  programId   String           @db.Uuid
  status      EnrollmentStatus @default(ACTIVE)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program     Program          @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([studentId, programId])
  @@index([programId, status])
}

model LessonProgress {
  id           String         @id @default(uuid()) @db.Uuid
  studentId    String         @db.Uuid
  lessonId     String         @db.Uuid
  completed    Boolean        @default(false)
  completedAt  DateTime?
  lastViewedAt DateTime       @default(now())
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([studentId, lessonId])
  @@index([studentId, completed])
  @@index([lessonId, completed])
}

model BodyMeasurement {
  id             String         @id @default(uuid()) @db.Uuid
  studentId      String         @db.Uuid
  recordedById   String         @db.Uuid
  measuredAt     DateTime       @db.Date
  weightKg       Decimal?       @db.Decimal(5, 2)
  heightCm       Decimal?       @db.Decimal(5, 2)
  bmi            Decimal?       @db.Decimal(5, 2)
  bodyFatPercent Decimal?       @db.Decimal(5, 2)
  waistCm        Decimal?       @db.Decimal(5, 2)
  abdomenCm      Decimal?       @db.Decimal(5, 2)
  hipsCm         Decimal?       @db.Decimal(5, 2)
  chestCm        Decimal?       @db.Decimal(5, 2)
  rightArmCm     Decimal?       @db.Decimal(5, 2)
  leftArmCm      Decimal?       @db.Decimal(5, 2)
  rightThighCm   Decimal?       @db.Decimal(5, 2)
  leftThighCm    Decimal?       @db.Decimal(5, 2)
  rightCalfCm    Decimal?       @db.Decimal(5, 2)
  leftCalfCm     Decimal?       @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy     User           @relation("MeasurementAuthor", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([studentId, measuredAt(sort: Desc)])
  @@index([recordedById])
}

model ProgressPhoto {
  id        String         @id @default(uuid()) @db.Uuid
  studentId String         @db.Uuid
  photoUrl  String
  pose      PhotoPose
  takenAt   DateTime       @db.Date
  notes     String?
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, takenAt(sort: Desc)])
}

model Announcement {
  id            String                  @id @default(uuid()) @db.Uuid
  createdById   String                  @db.Uuid
  title         String
  message       String
  imageUrl      String?
  audience      Audience                @default(ALL)
  status        PublishStatus           @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     User                    @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  recipients    AnnouncementRecipient[]
  notifications Notification[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([createdById])
}

model AnnouncementRecipient {
  announcementId String         @db.Uuid
  studentId      String         @db.Uuid
  announcement   Announcement   @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([announcementId, studentId])
  @@index([studentId])
}

model Notification {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  announcementId String?       @db.Uuid
  title          String
  message        String
  readAt         DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(sort: Desc)])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
