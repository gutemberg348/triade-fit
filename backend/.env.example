NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://essenza:essenza_dev@localhost:5433/essenza?schema=public
JWT_ACCESS_SECRET=change-this-access-secret-with-at-least-32-characters
JWT_REFRESH_SECRET=change-this-refresh-secret-with-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081
PUBLIC_BASE_URL=http://192.168.3.159:3333
# Use a chave da conta Asaas. Nunca exponha esta chave no app mobile ou admin.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Gere um token forte no Asaas ao criar o Webhook e copie o mesmo valor aqui.
ASAAS_WEBHOOK_TOKEN=
# IA da Luna. A chave fica somente no backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Opcional em Linux/macOS local se o ffmpeg não estiver no PATH. No Windows há fallback empacotado.
FFMPEG_PATH=
ADMIN_EMAIL=personal@essenza.com
ADMIN_PASSWORD=Essenza@2026
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Essenza <nao-responda@essenza.com>
