{
  "name": "essenza-personal",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "admin",
    "mobile"
  ],
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1"
  },
  "scripts": {
    "dev:backend": "npm --workspace backend run dev",
    "dev:admin": "npm --workspace admin run dev",
    "dev:mobile": "npm --workspace mobile run start",
    "test": "npm --workspace backend test",
    "build": "npm --workspace backend run check && npm --workspace admin run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.16.0",
    "react-native-svg": "15.12.1"
  }
}
