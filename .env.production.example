# Copie para .env.production somente no servidor. Nunca envie o arquivo real ao Git.
COMPOSE_PROJECT_NAME=triade-fit

# Portas no host. A API continua escutando 3333 dentro do container.
TRIADE_API_PORT=3335
TRIADE_ADMIN_PORT=4174

POSTGRES_USER=triade
POSTGRES_PASSWORD=troque_por_uma_senha_longa_apenas_com_letras_e_numeros
POSTGRES_DB=triade_fit
DATABASE_URL=postgresql://triade:troque_por_uma_senha_longa_apenas_com_letras_e_numeros@postgres:5432/triade_fit?schema=public

NODE_ENV=production
JWT_ACCESS_SECRET=gere_uma_chave_unica_de_no_minimo_32_caracteres
JWT_REFRESH_SECRET=gere_outra_chave_unica_de_no_minimo_32_caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

PUBLIC_BASE_URL=https://triade-api.testes-techcode.shop
CORS_ORIGINS=https://admin-triade-fit.testes-techcode.shop,https://triade-fit.com
VITE_API_URL=https://triade-api.testes-techcode.shop/api

# Sandbox: a chave deve começar com $aact_hmlg_. Produção: $aact_prod_.
# As aspas simples são obrigatórias aqui para o Docker Compose preservar o caractere $.
# Exemplo: ASAAS_API_KEY='$aact_hmlg_COLE_A_CHAVE_COMPLETA_AQUI'
ASAAS_API_KEY=''
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=gere_um_token_de_webhook_com_no_minimo_32_caracteres

# OpenAI usada pela Luna para alimentos e ajuda com treino. Nunca envie ao app ou ao Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# A imagem Docker já instala ffmpeg; deixe vazio, salvo se usar um binário customizado.
FFMPEG_PATH=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Triade FIT <nao-responda@triade-fit.com>

# Usado uma única vez por `npm run admin:create` para iniciar o painel.
ADMIN_NAME=Administradora Triade FIT
ADMIN_EMAIL=admin@triade-fit.com
ADMIN_PASSWORD=troque_por_uma_senha_forte
